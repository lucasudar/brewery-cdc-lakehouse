<mxfile host="gen.py"><diagram id="p0" name="1. Architecture &amp; data flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;font style=&#x27;font-size:26px&#x27;&gt;&lt;b&gt;Brewery lakehouse: near-real-time CDC&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;Postgres → Debezium → Redpanda → Iceberg (bronze / silver / gold) → FastAPI · measured end to end ≈ 7 s (target 60 s) · everything in docker compose&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Source&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="240" height="600" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Postgres 16&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;beer_factory&lt;br&gt;novisto_consumption&lt;br&gt;wal_level=logical&lt;br&gt;REPLICA IDENTITY FULL&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c2"><mxGeometry x="15" y="60" width="210" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Change capture &amp; log&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="290" height="600" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Debezium 3.3&lt;/b&gt; (Kafka Connect)&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;pgoutput · initial snapshot&lt;br&gt;then streaming · heartbeat&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c4"><mxGeometry x="15" y="60" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Redpanda&lt;/b&gt; (Kafka API)&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;cdc.public.beer_factory&lt;br&gt;cdc.public.novisto_consumption&lt;br&gt;cdc.dlq · Connect offsets&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c4"><mxGeometry x="15" y="260" width="260" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Ingestion&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="100" width="260" height="280" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ingestor&lt;/b&gt; (PyIceberg)&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;micro-batch ≤ 5 s&lt;br&gt;dedup per PK · LSN guard&lt;br&gt;schema evolution · DLQ&lt;br&gt;offsets in snapshot summary&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c7"><mxGeometry x="15" y="60" width="230" height="140" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Transformation&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="260" height="280" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;transformer&lt;/b&gt; (dbt-duckdb)&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;runs on new silver snapshots&lt;br&gt;pinned AT (VERSION =&amp;gt; id)&lt;br&gt;23 data tests · then publish&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c9"><mxGeometry x="15" y="60" width="230" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;DuckDB&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;in-memory engine for dbt&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=48;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c9"><mxGeometry x="15" y="205" width="230" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Lakehouse · Apache Iceberg v2&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F4F8;strokeColor=#10739E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="450" height="600" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;bronze.cdc_events&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;append-only changelog · partitioned by day&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=50;spacing=6;fillColor=#FBF3E8;strokeColor=#B07A3A;fontSize=11;shadow=1;" vertex="1" parent="c12"><mxGeometry x="15" y="60" width="420" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;silver.beer_factory&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;current state&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=50;spacing=6;fillColor=#F4F6F8;strokeColor=#7D8C99;fontSize=11;shadow=1;" vertex="1" parent="c12"><mxGeometry x="15" y="150" width="205" height="64" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;silver.novisto_&lt;br&gt;consumption&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;current state&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=50;spacing=6;fillColor=#F4F6F8;strokeColor=#7D8C99;fontSize=11;shadow=1;" vertex="1" parent="c12"><mxGeometry x="230" y="150" width="205" height="64" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;gold.daily_style_consumption&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;litres per day × style × site · lineage in snapshot&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=50;spacing=6;fillColor=#FFF8DC;strokeColor=#C9A227;fontSize=11;shadow=1;" vertex="1" parent="c12"><mxGeometry x="15" y="330" width="420" height="64" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Iceberg REST catalog&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;JDBC catalog on its&lt;br&gt;own Postgres&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=50;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c12"><mxGeometry x="15" y="440" width="205" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;SeaweedFS&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;S3 · s3://warehouse&lt;br&gt;metadata + Parquet&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=50;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c12"><mxGeometry x="230" y="440" width="205" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font color=&#x27;#666666&#x27;&gt;format v2 · copy-on-write deletes · snapshot expiry + compaction&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="c12"><mxGeometry x="15" y="530" width="420" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Serving&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBEFEF;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="270" height="600" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;/v1/beers · /v1/consumption&lt;br&gt;/v1/metrics/daily-style-consumption&lt;br&gt;/freshness · /health&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c20"><mxGeometry x="15" y="60" width="240" height="120" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;OpenAPI&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;/docs (Swagger) · /redoc&lt;br&gt;examples on every model&lt;/font&gt;" style="label;whiteSpace=wrap;html=1;rounded=1;arcSize=10;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;align=left;verticalAlign=middle;spacingLeft=56;spacing=6;fillColor=#ffffff;strokeColor=#999999;fontSize=11;shadow=1;" vertex="1" parent="c20"><mxGeometry x="15" y="260" width="240" height="80" as="geometry"/></mxCell><mxCell id="c23" value="WAL&lt;br&gt;pgoutput" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="change events&lt;br&gt;JSON + schema" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="consume" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="420"/><mxPoint x="610" y="230"/></Array></mxGeometry></mxCell><mxCell id="c26" value="append" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" x="0.6" as="geometry"><Array as="points"><mxPoint x="915" y="230"/><mxPoint x="915" y="192"/></Array></mxGeometry></mxCell><mxCell id="c27" value="upsert /&lt;br&gt;delete" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" x="0.6" as="geometry"><Array as="points"><mxPoint x="915" y="230"/><mxPoint x="915" y="270"/></Array></mxGeometry></mxCell><mxCell id="c28" value="read pinned&lt;br&gt;snapshots" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.85;entryX=1;entryY=0.3;" edge="1" parent="1" source="c14" target="c10"><mxGeometry relative="1" x="-0.45" as="geometry"><Array as="points"><mxPoint x="900" y="304"/><mxPoint x="900" y="519"/></Array></mxGeometry></mxCell><mxCell id="c29" value="publish if&lt;br&gt;tests pass" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" x="-0.2" as="geometry"><Array as="points"><mxPoint x="918" y="584"/><mxPoint x="918" y="462"/></Array></mxGeometry></mxCell><mxCell id="c30" value="snapshot&lt;br&gt;reads" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="auto-generated" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Exactly-once effect &amp; recovery"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;font style=&#x27;font-size:26px&#x27;&gt;&lt;b&gt;How a change is applied exactly once&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;No two-phase commit: Iceberg snapshots carry the progress (Kafka offsets, source snapshot ids), so data and progress are committed atomically and a restart resumes from the table itself&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;ingestor: one micro-batch (≤ 5 s or 5 000 events)&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1574" height="300" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1. Poll&lt;/b&gt;&lt;br&gt;Redpanda, manual offsets" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="20" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2. Parse envelope&lt;/b&gt;&lt;br&gt;types from Connect schema&lt;br&gt;bad message → &lt;i&gt;cdc.dlq&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="244" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3. Skip replays&lt;/b&gt;&lt;br&gt;offset ≤ offset already&lt;br&gt;committed by this table" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="468" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4. Latest per PK&lt;/b&gt;&lt;br&gt;max (lsn, offset) wins&lt;br&gt;insert+delete → nothing" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="692" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5. LSN guard&lt;/b&gt;&lt;br&gt;never overwrite a row&lt;br&gt;with an older change" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="916" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6. One Iceberg commit&lt;br&gt;per table&lt;/b&gt;&lt;br&gt;delete + append (CoW)&lt;br&gt;+ offsets in snapshot" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9A227;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="1140" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7. Kafka commit&lt;/b&gt;&lt;br&gt;monitoring only&lt;br&gt;(lag dashboards)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="1364" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Restart / crash / rebalance&lt;/b&gt;&lt;br&gt;read offsets from the latest snapshot summary of every table → seek to the slowest one → each table skips what it already has. Replaying the whole topic is a no-op." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7D8C99;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c2"><mxGeometry x="468" y="190" width="638" height="86" as="geometry"/></mxCell><mxCell id="c17" value="resume" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c16" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="durable state" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;transformer: write-audit-publish&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;container=1;collapsible=0;recursiveResize=0;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1386" height="260" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;1. Resolve input&lt;/b&gt;&lt;br&gt;current snapshot id of&lt;br&gt;each silver table" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="20" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Already published?&lt;/b&gt;&lt;br&gt;compare with lineage in&lt;br&gt;gold snapshot summary" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="304" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;3. dbt build&lt;/b&gt;&lt;br&gt;sources pinned with&lt;br&gt;AT (VERSION =&amp;gt; id)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="588" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;4. Audit&lt;/b&gt;&lt;br&gt;unique · not_null · grain&lt;br&gt;reconciles with staging" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="872" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;5. Publish&lt;/b&gt;&lt;br&gt;atomic overwrite of gold&lt;br&gt;+ input ids as lineage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8DC;strokeColor=#C9A227;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="1156" y="50" width="190" height="96" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="no" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="pass" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;yes → nothing to do&lt;/b&gt;&lt;br&gt;restart never republishes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7D8C99;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="304" y="180" width="190" height="60" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;fail → gold unchanged&lt;/b&gt;&lt;br&gt;API keeps serving the last&lt;br&gt;good mart; retried on new data" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEFEF;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;shadow=1;" vertex="1" parent="c19"><mxGeometry x="872" y="180" width="190" height="66" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c21" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="html=1;rounded=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c23" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
